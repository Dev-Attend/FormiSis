// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  COMERCIAL
  PRE_VENDAS
  LEITURA
}

/// Ciclo de vida da proposta no sistema (fluxo operacional).
enum FormStatus {
  DRAFT
  IN_PROGRESS
  PAUSED
  FINALIZED
  ARCHIVED
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  passwordHash       String
  role               UserRole
  companyId          String?
  company            Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  submissions        Submission[]
  formSessions       FormSession[]
  audits             AuditLog[]
  proposalRevisions  ProposalRevision[]

  @@index([companyId])
}

model Company {
  id         String      @id @default(cuid())
  name       String
  slug       String      @unique
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  formBlocks FormBlock[]
}

model FormBlock {
  id          String         @id @default(cuid())
  companyId   String
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  blockKey    String
  title       String
  description String?
  order       Int
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  questions   FormQuestion[]

  @@unique([companyId, blockKey])
  @@index([companyId, active, order])
}

model FormQuestion {
  id              String    @id @default(cuid())
  blockId         String
  block           FormBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  fieldId         String
  label           String
  type            String
  placeholder     String?
  helpText        String?
  requiredDefault Boolean   @default(false)
  optionsJson     String?
  validationJson  String?
  order           Int
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([blockId, fieldId])
  @@index([blockId, active, order])
}

model Submission {
  id             String     @id @default(cuid())
  internalName   String
  payloadJson    String
  warningsJson   String
  generatedDoc   String
  generatedAt    DateTime   @default(now())
  createdById    String
  createdBy      User       @relation(fields: [createdById], references: [id])
  audits         AuditLog[]
}

model AuditLog {
  id             String       @id @default(cuid())
  action         String
  resourceType   String
  resourceId     String
  detailsJson    String
  createdAt      DateTime     @default(now())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  submissionId   String?
  submission     Submission?  @relation(fields: [submissionId], references: [id])
  formSessionId  String?
  formSession    FormSession? @relation(fields: [formSessionId], references: [id], onDelete: SetNull)

  @@index([formSessionId, createdAt])
}

model FormSession {
  id                 String              @id @default(cuid())
  title              String
  status             FormStatus          @default(DRAFT)
  clientName         String?
  opportunityRef     String?
  revision           Int                 @default(1)
  payloadJson        String
  warningsJson       String
  startedAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  finalizedAt        DateTime?
  finalDocument        String?
  createdById        String
  createdBy          User                @relation(fields: [createdById], references: [id])
  audits             AuditLog[]
  proposalRevisions  ProposalRevision[]

  @@index([createdById, updatedAt])
  @@index([status, updatedAt])
}

/// Snapshot imutavel apos cada persistencia relevante (auditoria e reabertura segura).
model ProposalRevision {
  id             String      @id @default(cuid())
  formSessionId  String
  formSession    FormSession @relation(fields: [formSessionId], references: [id], onDelete: Cascade)
  status         FormStatus
  payloadJson    String
  warningsJson   String
  note           String?
  createdById    String
  createdBy      User        @relation(fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())

  @@index([formSessionId, createdAt])
}
